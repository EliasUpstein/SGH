{
  "name": "sgh-sistema-gestion-horaria",
  "version": "1.0.0",
  "description": "Sistema de Gestión Horaria Escolar (SGH) - 100% Offline y Portable",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build:css": "tailwindcss -i ./src/renderer/styles/input.css -o ./src/renderer/styles/output.css --minify",
    "test": "node tests/phase1.test.js && node tests/phase2.test.js && node tests/phase3.test.js && node tests/phase4.test.js && node tests/phase5.test.js",
    "pack:dir": "node scripts/build_portable.js",
    "pack:portable": "node scripts/build_portable.js"
  },
  "build": {
    "appId": "edu.sgh.gestionhoraria",
    "productName": "SGH - Gestion Horaria Escolar",
    "directories": {
      "output": "dist_portable"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "data",
        "to": "data",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "dir"
      ]
    },
    "portable": {
      "artifactName": "SGH_Portable.exe"
    }
  },
  "keywords": [
    "horarios",
    "escuela",
    "secundaria",
    "enroques",
    "horas-puente",
    "electron"
  ],
  "author": "Elias Upstein <eliasupstein@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^3.4.17"
  }
}
